Program Strict
    Define x As Integer;
    x <- 1;
    When x = 1 Then
        Write "one";
    EndIf
    if x = 2 Then
        Write "never";
    EndIf
    Write Ábs(x);
    Dimension arr[3];
    For i <- 1 To 3 Step 1
        arr[i] <- i * 2;
    EndFor
    y <- x + 1.5 - 2 / 4 ^ 2;
    Write "sum: ", y, arr[1];
EndProgram
