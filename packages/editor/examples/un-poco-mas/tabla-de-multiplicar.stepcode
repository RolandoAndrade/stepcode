// título: Tabla de multiplicar
// descripción: Ciclos anidados
Proceso TablaDeMultiplicar
  Definir numero, i, j Como Entero;
  Escribir 'Introduce hasta qué número quieres tablas: ';
  Leer numero;
  Para i <- 1 Hasta numero Hacer
    Para j <- 1 Hasta 10 Hacer
      Escribir i, ' x ', j, ' = ', i * j;
    FinPara
  FinPara
FinProceso
