// título: El mayor del arreglo
// descripción: Recorre un arreglo buscando el máximo
Proceso MayorDelArreglo
  Definir numeros Como Entero;
  Definir i, mayor Como Entero;
  Dimension numeros[5];
  Para i <- 1 Hasta 5 Hacer
    Escribir 'Numero ', i, ':';
    Leer numeros[i];
  FinPara
  mayor <- numeros[1];
  Para i <- 2 Hasta 5 Hacer
    Si numeros[i] > mayor Entonces
      mayor <- numeros[i];
    FinSi
  FinPara
  Escribir 'El mayor es: ', mayor;
FinProceso
