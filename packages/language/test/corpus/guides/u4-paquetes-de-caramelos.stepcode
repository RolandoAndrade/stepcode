// Guía Práctica U4 — Pregunta 1: repartir caramelos en paquetes de 5 y de 2.
Proceso PaquetesDeCaramelos
    Definir caramelos, paquetesDeCinco, paquetesDeDos, sobrantes Como Entero;
    Escribir "Introduce un numero: ";
    Leer caramelos;
    paquetesDeCinco <- caramelos DIV 5;
    sobrantes <- caramelos MOD 5;
    paquetesDeDos <- sobrantes DIV 2;
    sobrantes <- sobrantes MOD 2;
    Escribir "Necesitas ", paquetesDeCinco, " paquetes de 5 caramelos.";
    Escribir "Necesitas ", paquetesDeDos, " paquetes de 2 caramelos.";
    Escribir "Sobran ", sobrantes, " caramelos.";
FinProceso
