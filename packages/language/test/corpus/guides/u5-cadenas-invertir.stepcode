// Guía U5 Cadenas — Pregunta 1: invertir una cadena carácter por carácter.
Funcion Invertida(frase Como Cadena): Cadena
    Definir salida Como Cadena;
    Definir i Como Entero;
    salida <- "";
    Para i <- 1 Hasta Longitud(frase) Hacer
        salida <- frase[i] + salida;
    FinPara
    Retornar salida;
FinFuncion

Proceso InvertirCadena
    Definir frase Como Cadena;
    Escribir "Introduce texto: ";
    Leer frase;
    Escribir "El resultado es: ", Invertida(frase);
FinProceso
