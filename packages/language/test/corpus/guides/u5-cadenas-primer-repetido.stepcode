// Guía U5 Cadenas — Pregunta 10: el primer carácter que se repite en un texto.
Proceso PrimerCaracterRepetido
    Definir frase Como Cadena;
    Definir i, j Como Entero;
    Definir encontrado Como Logico;
    Definir repetido Como Caracter;
    Escribir "Introduce texto: ";
    Leer frase;
    encontrado <- Falso;
    repetido <- ' ';
    Para i <- 1 Hasta Longitud(frase) - 1 Hacer
        Para j <- i + 1 Hasta Longitud(frase) Hacer
            Si No encontrado Y Minusculas(frase[i]) = Minusculas(frase[j]) Entonces
                encontrado <- Verdadero;
                repetido <- frase[i];
            FinSi
        FinPara
    FinPara
    Si encontrado Entonces
        Escribir "La letra ", repetido, " es la primera en repetirse.";
    Sino
        Escribir "Ninguna letra se repite.";
    FinSi
FinProceso
