Proceso prueba
          Definir a, b Como Entero;
          a <- 1;
          Mientras a <= 5 Hacer
            b <- 1;
            Mientras b <= 5 Hacer
              b <- b + 1;
              Si b MOD 2 <> 0 Entonces
                Continuar;
              FinSi
              Escribir a, ' * ', b - 1, ' = ', a * (b - 1);
            FinMientras
            a <- a + 1; 
          FinMientras
        FinProceso
