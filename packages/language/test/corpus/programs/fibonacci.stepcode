Proceso Fibonacci
    Definir n, a, b, c Como Entero;
    Definir i Como Entero;
    Escribir "Ingrese el numero de elementos de la serie";
    Leer n;
    a ← 0;
    b ← 1;
    Escribir a;
    Escribir b;
    Para i ← 3 Hasta n Con Paso 1 Hacer
        c ← a + b;
        Escribir c;
        a ← b;
        b ← c;
    FinPara
    FinProceso
