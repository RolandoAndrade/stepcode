SubProceso cambio(a Como Entero[])
        a[1] <- 10;
      FinSubProceso
      Proceso prueba
        Definir a, i Como Entero;
        Dimension a[3];
        a[1] <- 20;
        a[2] <- 30;
        a[3] <- 40;
        cambio(a);
        Para i <- 1 Hasta 3 Con Paso 1 Hacer
          Si i > 1 Entonces
            Escribir Sin Saltar ',';
          FinSi
          Escribir Sin Saltar a[i];
        FinPara
        Escribir '';
      FinProceso
