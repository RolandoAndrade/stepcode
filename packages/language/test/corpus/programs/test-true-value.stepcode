Proceso prueba
      Definir a, b, c Como Real;
      Definir x, yy, z Como Logico;
      Leer a, b, c;
      x <- a * b + c < a * (b + c);
      yy <- a * b + c > a * (b + c);
      z <- a * b + c = a * (b + c);
      Escribir x, yy, z;
      Escribir x Y yy O z;
      Escribir a * b + c < a * (b + c) Y a * b + c > a * (b + c) O a * b + c = a * (b + c);
      FinProceso
