SubProceso swap(a por referencia, b por referencia)
        Definir temp Como Entero;
        temp <- a;
        a <- b;
        b <- temp;
      FinSubProceso
      Proceso prueba
        Definir a, b Como Entero;
        a <- 10;
        b <- 20;
        swap(a, b);
        Escribir 'a=',a;
        Escribir 'b=',b;
      FinProceso
