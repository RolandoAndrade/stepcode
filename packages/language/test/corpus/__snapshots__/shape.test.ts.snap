byref)) (returns - -) (define (i) (type integer)) (for i posicion (binary minus cantidad (literal 1)) - (assign (index arreglo i) (index arreglo (binary plus i (literal 1))))) (assign cantidad (binary minus cantidad (literal 1)))) (procedure eliminarelemento (params (param arreglo (type integer [_]) byvalue) (param elemento (type integer) byvalue) (param cantidad (type integer) byref)) (returns - -) (callstmt (call eliminar arreglo (call buscar arreglo elemento cantidad) cantidad))) (procedure programainsertar (params (param arreglo (type integer [_]) byvalue) (param cantidad (type integer) byref)) (returns - -) (define (elemento posicion) (type integer)) (write (literal "Introduce elemento a insertar: ")) (read elemento) (write (literal "Introduce posicion a insertar: ")) (read posicion) (callstmt (call insertar arreglo elemento posicion cantidad))) (procedure programaeliminar (params (param arreglo (type integer [_]) byvalue) (param cantidad (type integer) byref)) (returns - -) (define (elemento) (type integer)) (write (literal "Introduce elemento a eliminar: ")) (read elemento) (callstmt (call eliminarelemento arreglo elemento cantidad))) (procedure programabuscar (params (param arreglo (type integer [_]) byvalue) (param cantidad (type integer) byref)) (returns - -) (define (elemento) (type integer)) (write (literal "Introduce elemento a buscar: ")) (read elemento) (write (literal "El elemento esta en la posicion: ") (call buscar arreglo elemento cantidad))) (main pruebas (define (arreglo cantidad) (type integer)) (define (opcion) (type integer)) (dimension (arreglo (literal 10))) (assign cantidad (call leerarreglo arreglo)) (repeat (write (literal "El arreglo es")) (callstmt (call mostrararreglo arreglo cantidad)) (write (literal "Introduce opcion: ")) (write (literal "    [1]: Insertar elemento")) (write (literal "    [2]: Eliminar elemento")) (write (literal "    [3]: Buscar elemento")) (write (literal "    [0]: Salir")) (read opcion) (switch opcion (case ((literal 1)) (callstmt (call programainsertar arreglo cantidad))) (case ((literal 2)) (callstmt (call programaeliminar arreglo cantidad))) (case ((literal 3)) (callstmt (call programabuscar arreglo cantidad)))) until (binary equal opcion (literal 0)))))"`;

exports[`the shape of a representative corpus program > test-assignation-function-with-parameters parses to a stable tree 1`] = `"(program (function prueba (params (param a (type integer) byvalue) (param b (type integer) byvalue)) (returns valor -) (write (literal "hola")) (assign valor (binary plus a b))) (main pruebaproceso (define (a) (type integer)) (assign a (call prueba (literal 10) (literal 20))) (write a)))"`;

exports[`the shape of a representative corpus program > test-basic-concatenation parses to a stable tree 1`] = `"(program (main prueba (define (a b c) (type string)) (assign a (literal "Hola")) (assign b (literal " mundo")) (assign c (binary plus a b)) (write c)))"`;

exports[`the shape of a representative corpus program > test-for-statement-with-positive-step parses to a stable tree 1`] = `"(program (main prueba (define (a) (type integer)) (for a (literal 1) (literal 5) (literal 2) (write a))))"`;

exports[`the shape of a representative corpus program > test-multiple-statements-in-case parses to a stable tree 1`] = `"(program (main prueba (define (a b) (type integer)) (assign a (literal 1)) (switch a (case ((literal 1)) (write (literal "a=1")) (assign b (literal 2)) (write (literal "b=2"))) (case ((literal 2)) (write (literal "a=2"))) (otherwise (write (literal "a!=1,2"))))))"`;

exports[`the shape of a representative corpus program > test-simple-repeat-until-statement parses to a stable tree 1`] = `"(program (main prueba (define (a) (type integer)) (assign a (literal 1)) (repeat (write a) (assign a (binary plus a (literal 1))) until (binary gt a (literal 5)))))"`;

exports[`the shape of a representative corpus program > test-while-statement-with-break parses to a stable tree 1`] = `"(program (main prueba (define (a) (type integer)) (assign a (literal 1)) (while (binary lt a (literal 5)) (write a) (assign a (binary plus a (literal 1))) (if (binary equal a (literal 3)) (break)))))"`;
