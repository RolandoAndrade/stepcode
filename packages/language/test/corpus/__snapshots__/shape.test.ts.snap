exports[`the shape of a representative corpus program > addition parses to a stable tree 1`] = `"(program (procedure ordenar (params (param n1 (type string) byref) (param n2 (type string) byref)) (returns - -) (define (aux) (type string)) (if (binary lt (builtin length n1) (builtin length n2)) (assign aux n1) (assign n1 n2) (assign n2 aux))) (function invertircadena (params (param str (type string) byvalue)) (returns strinvertida -) (define (i) (type integer)) (assign strinvertida (literal "")) (for i (literal 1) (builtin length str) (literal 1) (assign strinvertida (binary plus (index str i) strinvertida)))) (main sumarcomoprimaria (define (n1 n2 resultado) (type string)) (define (i suma acarreo) (type integer)) (write (literal "n1")) (read n1) (write (literal "n2")) (read n2) (callstmt (call ordenar n1 n2)) (assign n1 (call invertircadena n1)) (assign n2 (call invertircadena n2)) (assign resultado (literal "")) (assign acarreo (literal 0)) (assign suma (literal 0)) (for i (literal 1) (builtin length n2) (literal 1) (assign suma (builtin trunc (binary plus (binary plus (builtin toNumber (index n1 i)) (builtin toNumber (index n2 i))) acarreo))) (assign acarreo (binary div suma (literal 10))) (assign suma (binary mod suma (literal 10))) (assign resultado (binary plus (builtin toText suma) resultado))) (for i (binary plus (builtin length n2) (literal 1)) (builtin length n1) (literal 1) (assign suma (builtin trunc (binary plus (builtin toNumber (index n1 i)) acarreo))) (assign acarreo (binary div suma (literal 10))) (assign suma (binary mod suma (literal 10))) (assign resultado (binary plus (builtin toText suma) resultado))) (if (binary gt acarreo (literal 0)) (assign resultado (binary plus (builtin toText acarreo) resultado))) (write resultado)))"`;

